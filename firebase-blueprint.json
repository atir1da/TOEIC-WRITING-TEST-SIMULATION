{
  "entities": {
    "users": {
      "title": "User",
      "description": "User profile and statistics",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "englishLevel": { "type": "string", "enum": ["Basic", "Intermediate", "Advanced"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt", "englishLevel"]
    },
    "attempts": {
      "title": "Attempt",
      "description": "Logs of user exercise attempts",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "part": { "type": "string", "enum": ["PART1", "PART2", "PART3"] },
        "score": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "part", "score", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile document"
    },
    "/attempts/{attemptId}": {
      "schema": "attempts",
      "description": "History of user exercises"
    }
  }
}
